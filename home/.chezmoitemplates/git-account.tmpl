{{- /* Commit identity for one GitHub account. Call with (dict "ctx" . "user" "<account>"). */ -}}
{{- $found := false -}}
{{- range .ctx.github.accounts -}}
{{- if eq .user $.user -}}
{{- $found = true -}}
# Generated by chezmoi from .chezmoidata/github.yaml ({{ .user }}).
[user]
	name = {{ .name }}
	email = {{ .email }}
{{ end -}}
{{- end -}}
{{- if not $found -}}
{{- fail (printf "git-account.tmpl: no account %q in .chezmoidata/github.yaml" .user) -}}
{{- end -}}
