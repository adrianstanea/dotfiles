{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

case "$(uname -m)" in
  x86_64 | amd64) asset=nvim-linux-x86_64 ;;
  aarch64 | arm64) asset=nvim-linux-arm64 ;;
  *)
    echo "Unsupported architecture for the Neovim release tarball: $(uname -m)." >&2
    exit 1
    ;;
esac
install_dir="/opt/$asset"

priv=""
[[ $EUID -eq 0 ]] || priv="sudo"

if [[ -x "$install_dir/bin/nvim" ]]; then
  echo "Neovim already installed at $install_dir."
else
  download_dir="$(mktemp -d)"
  trap 'rm -rf "$download_dir"' EXIT

  echo "Downloading latest stable Neovim release ($asset)..."
  curl -fsSL --output "$download_dir/$asset.tar.gz" \
    "https://github.com/neovim/neovim/releases/latest/download/$asset.tar.gz"

  $priv rm -rf "$install_dir"
  $priv tar -C /opt -xzf "$download_dir/$asset.tar.gz"
  echo "Installed $("$install_dir/bin/nvim" --version | head -n1)"
fi

# Make `nvim` resolve in any shell (bash, dev containers), not only zsh with
# the PATH set up by ~/.config/zsh/10-paths.zsh.
$priv ln -sf "$install_dir/bin/nvim" /usr/local/bin/nvim
echo "Linked /usr/local/bin/nvim -> $install_dir/bin/nvim"
{{- end }}
