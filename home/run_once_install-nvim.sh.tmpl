{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

install_dir=/opt/nvim-linux-x86_64

priv=""
[[ $EUID -eq 0 ]] || priv="sudo"

if [[ -x "$install_dir/bin/nvim" ]]; then
  echo "Neovim already installed at $install_dir."
else
  if [[ "$(uname -m)" != "x86_64" ]]; then
    echo "This script only supports x86_64; found $(uname -m)." >&2
    exit 1
  fi

  download_dir="$(mktemp -d)"
  trap 'rm -rf "$download_dir"' EXIT

  echo "Downloading latest stable Neovim release..."
  curl -fsSL --output "$download_dir/nvim-linux-x86_64.tar.gz" \
    https://github.com/neovim/neovim/releases/latest/download/nvim-linux-x86_64.tar.gz

  $priv rm -rf "$install_dir"
  $priv tar -C /opt -xzf "$download_dir/nvim-linux-x86_64.tar.gz"
  echo "Installed $("$install_dir/bin/nvim" --version | head -n1)"
fi

# Make `nvim` resolve in any shell (bash, dev containers), not only zsh with
# the PATH set up by ~/.config/zsh/10-paths.zsh.
$priv ln -sf "$install_dir/bin/nvim" /usr/local/bin/nvim
echo "Linked /usr/local/bin/nvim -> $install_dir/bin/nvim"
{{- end }}
