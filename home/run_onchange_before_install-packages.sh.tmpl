{{- if or .features.i3 .features.gitSource }}
#!/usr/bin/env bash
set -euo pipefail

if [[ ! -r /etc/os-release ]]; then
  echo "Cannot identify the Linux distribution; Ubuntu is required for feature packages." >&2
  exit 1
fi
. /etc/os-release
if [[ "${ID:-}" != "ubuntu" ]]; then
  echo "APT feature packages are currently supported only on Ubuntu (found ${ID:-unknown})." >&2
  exit 1
fi

packages=()
{{ if .features.i3 -}}
packages+=( {{ range .packages.apt.i3 }}{{ . | quote }} {{ end }} )
{{ end -}}
{{ if .features.gitSource -}}
packages+=( {{ range .packages.apt.gitSource }}{{ . | quote }} {{ end }} )
{{ end -}}

if (( ${#packages[@]} > 0 )); then
  sudo apt-get update
  sudo apt-get install --yes "${packages[@]}"
fi
{{- end }}