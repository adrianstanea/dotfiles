#!/usr/bin/env bash
# Git credential helper that picks a GitHub account per directory tree or
# repository owner, and serves that account's token from gh.
#
# Rules: ~/.config/git/gh-accounts.tsv (generated from .chezmoidata/github.yaml).
# Resolution: explicit username > longest matching dir > owner > default.
# Tokens: $GH_TOKEN_<ACCOUNT> > gh hosts.yml (gh auth token --user) > system-level helpers
# (e.g. the VS Code Dev Containers forwarder to the host).
#
# Usage:
#   git-credential-gh-account get|store|erase   (called by git)
#   git-credential-gh-account resolve [dir]     print the account for dir
#   git-credential-gh-account token <account>   print the account's token
#   git-credential-gh-account accounts          list configured accounts
#   git-credential-gh-account whoami [dir]      explain the resolution
set -uo pipefail

rules_file=${GH_ACCOUNTS_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/git/gh-accounts.tsv}
self_name=git-credential-gh-account

account=''
rule=''

# Owner of a GitHub URL or "owner/repo" path, e.g. https://x@github.com/o/r.git -> o.
github_owner() {
  local url=$1
  case $url in
    *github.com[:/]*) url=${url#*github.com[:/]} ;;
    *://*) return 1 ;;
  esac
  url=${url#/}
  [[ $url == */* ]] || return 1
  printf '%s\n' "${url%%/*}"
}

# resolve_account <dir> <owner> <username>; sets $account and $rule.
resolve_account() {
  local dir=$1 owner=$2 username=$3
  local physical kind key value best_len=-1 default_account=''
  account='' rule=''

  if [[ -n $username ]]; then
    account=$username rule="username in URL"
    return 0
  fi

  physical=$(cd -- "$dir" 2>/dev/null && pwd -P) || physical=$dir
  if [[ -z $owner ]]; then
    owner=$(github_owner "$(git -C "$dir" remote get-url origin 2>/dev/null)") || owner=''
  fi

  [[ -r $rules_file ]] || return 1
  while IFS=$'\t' read -r kind key value; do
    case $kind in
      dir)
        if [[ $dir == "$key" || $dir == "$key"/* || $physical == "$key" || $physical == "$key"/* ]] &&
          ((${#key} > best_len)); then
          account=$value rule="dir $key" best_len=${#key}
        fi
        ;;
      owner)
        if ((best_len < 0)) && [[ -n $owner && ${owner,,} == "${key,,}" && $rule != owner* ]]; then
          account=$value rule="owner $key"
        fi
        ;;
      default) default_account=$value ;;
    esac
  done <"$rules_file"

  if [[ -z $account && -n $default_account ]]; then
    account=$default_account rule=default
  fi
  [[ -n $account ]]
}

# Run the system-level credential helpers (never ourselves) with the request.
system_helpers_get() {
  local request=$1 helper command output
  while IFS= read -r helper; do
    [[ -n $helper && $helper != *"$self_name"* ]] || continue
    case $helper in
      '!'*) command=${helper#!} ;;
      /*) command=$helper ;;
      *) command="git credential-$helper" ;;
    esac
    output=$(printf '%s\n' "$request" | sh -c "$command get" 2>/dev/null) || continue
    if [[ $output == *password=* ]]; then
      printf '%s\n' "$output" | sed -n 's/^password=//p'
      return 0
    fi
  done < <(git config --system --get-all credential.helper 2>/dev/null)
  return 1
}

# gh_token <account> [VAR=value...]; prints the token gh stores for the account.
gh_token() {
  local account_name=$1 token
  shift
  token=$(env -u GH_TOKEN -u GITHUB_TOKEN "$@" timeout "${GH_ACCOUNT_TIMEOUT:-5}" \
    gh auth token --hostname github.com --user "$account_name" </dev/null 2>/dev/null)
  [[ -n $token ]] && printf '%s\n' "$token"
}

# token_for <account> [request]; prints the token.
token_for() {
  local account_name=$1 request=${2:-} variable token
  variable=${account_name^^}
  variable=GH_TOKEN_${variable//[^A-Z0-9]/_}
  if [[ -n ${!variable:-} ]]; then
    printf '%s\n' "${!variable}"
    return 0
  fi
  if command -v gh >/dev/null 2>&1; then
    # Read gh's hosts.yml (gh auth login --insecure-storage): with D-Bus disabled gh
    # skips the keyring, which blocks on an unlock prompt when gnome-keyring is
    # locked (e.g. under WSL). Set GH_ACCOUNT_KEYRING=1 to also try the keyring.
    token=$(gh_token "$account_name" DBUS_SESSION_BUS_ADDRESS=disabled:) ||
      { [[ ${GH_ACCOUNT_KEYRING:-0} == 1 ]] && token=$(gh_token "$account_name"); }
    if [[ -n $token ]]; then
      printf '%s\n' "$token"
      return 0
    fi
  fi
  [[ -n $request ]] || request=$'protocol=https\nhost=github.com'
  system_helpers_get "$request"$'\n'"username=$account_name"
}

credential_get() {
  local key value protocol='' host='' path='' username='' request token
  while IFS='=' read -r key value; do
    [[ -n $key ]] || break
    case $key in
      protocol) protocol=$value ;;
      host) host=$value ;;
      path) path=$value ;;
      username) username=$value ;;
    esac
  done
  [[ $host == github.com ]] || return 0

  resolve_account "$PWD" "$(github_owner "$path" || true)" "$username" || return 0
  request="protocol=${protocol:-https}"$'\n'"host=$host"
  [[ -n $path ]] && request+=$'\n'"path=$path"
  token=$(token_for "$account" "$request") || return 0
  [[ -n $token ]] || return 0
  printf 'username=%s\npassword=%s\n' "$account" "$token"
}

case ${1:-} in
  get) credential_get ;;
  store | erase) cat >/dev/null ;;
  resolve)
    resolve_account "${2:-$PWD}" '' '' || exit 1
    printf '%s\n' "$account"
    ;;
  token)
    [[ -n ${2:-} ]] || { echo "usage: $self_name token <account>" >&2; exit 2; }
    token_for "$2"
    ;;
  accounts)
    [[ -r $rules_file ]] || exit 1
    awk -F'\t' '$1 == "default" || $1 == "dir" || $1 == "owner" { if (!seen[$3]++) print $3 }' "$rules_file"
    ;;
  whoami)
    dir=${2:-$PWD}
    if ! resolve_account "$dir" '' ''; then
      echo "no account: $rules_file is missing or has no default" >&2
      exit 1
    fi
    printf 'account:  %s\nrule:     %s\nidentity: %s <%s>\n' "$account" "$rule" \
      "$(git -C "$dir" config user.name)" "$(git -C "$dir" config user.email)"
    ;;
  *)
    sed -n '2,/^set -uo/{/^#/s/^# \{0,1\}//p}' "$0" >&2
    exit 2
    ;;
esac
