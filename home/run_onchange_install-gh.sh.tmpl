#!/usr/bin/env bash
# Install or upgrade the GitHub CLI to at least the minimum in .chezmoidata/tools.yaml, then
# install/upgrade gh extensions. Re-runs when the template content (minVersion, extensions) changes.
# gh minVersion: {{ .gh.minVersion }}
set -euo pipefail

min_version={{ .gh.minVersion | quote }}
extensions=({{ range .gh.extensions }}{{ . | quote }} {{ end }})
prefix="${GH_INSTALL_PREFIX:-$HOME/.local}"

if [[ "$(uname -s)" != "Linux" ]]; then
  echo "Skipping gh install: Linux only." >&2
  exit 0
fi

# True when $1 >= $2 (dotted versions).
version_ge() { [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1)" == "$2" ]]; }

gh_version() {
  local bin="${1:-gh}"
  "$bin" --version 2>/dev/null | sed -n '1s/^gh version \([0-9][0-9.]*\).*/\1/p'
}

gh_ok() {
  local v
  v="$(gh_version "${1:-gh}")"
  [[ -n "$v" ]] && version_ge "$v" "$min_version"
}

sudo=""
[[ $EUID -eq 0 ]] || sudo="sudo"
can_sudo() { [[ -z "$sudo" ]] || { command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; }; }

install_apt_repo() {
  local keyring=/etc/apt/keyrings/githubcli-archive-keyring.gpg tmp_key
  echo "Using the official GitHub CLI apt repository."
  $sudo mkdir -p -m 755 /etc/apt/keyrings
  tmp_key="$(mktemp)"
  curl --fail --silent --show-error --location \
    https://cli.github.com/packages/githubcli-archive-keyring.gpg --output "$tmp_key"
  $sudo install -m 644 "$tmp_key" "$keyring"
  rm -f "$tmp_key"
  echo "deb [arch=$(dpkg --print-architecture) signed-by=$keyring] https://cli.github.com/packages stable main" \
    | $sudo tee /etc/apt/sources.list.d/github-cli.list >/dev/null
  $sudo apt-get update
  $sudo apt-get install -y gh
}

install_with_package_manager() {
  if command -v apt-get >/dev/null 2>&1; then
    # The distro package lags (Debian ships 2.46), so use GitHub's own repo.
    install_apt_repo
  elif command -v dnf >/dev/null 2>&1; then
    $sudo dnf install -y gh
  elif command -v pacman >/dev/null 2>&1; then
    $sudo pacman -S --noconfirm --needed github-cli
  elif command -v zypper >/dev/null 2>&1; then
    $sudo zypper --non-interactive install gh
  else
    return 1
  fi
}

install_from_tarball() {
  local arch tag version name url tmp
  case "$(uname -m)" in
    x86_64 | amd64) arch=amd64 ;;
    aarch64 | arm64) arch=arm64 ;;
    *) echo "No gh release tarball for $(uname -m)." >&2; return 1 ;;
  esac
  tag="$(curl --fail --silent --show-error --location -o /dev/null -w '%{url_effective}' \
    https://github.com/cli/cli/releases/latest)"
  tag="${tag##*/}"
  version="${tag#v}"
  name="gh_${version}_linux_${arch}.tar.gz"
  url="https://github.com/cli/cli/releases/download/${tag}"
  tmp="$(mktemp -d)"
  echo "Downloading gh $version from GitHub releases..."
  curl --fail --silent --show-error --location "$url/$name" --output "$tmp/$name"
  curl --fail --silent --show-error --location "$url/gh_${version}_checksums.txt" \
    --output "$tmp/checksums.txt"
  (cd "$tmp" && grep -F " $name" checksums.txt | sha256sum --check --strict -) || {
    echo "Checksum verification failed for $name." >&2
    rm -rf "$tmp"
    return 1
  }
  tar -xzf "$tmp/$name" -C "$tmp"
  mkdir -p "$prefix/bin"
  install -m 755 "$tmp/gh_${version}_linux_${arch}/bin/gh" "$prefix/bin/gh"
  rm -rf "$tmp"
  echo "Installed gh $version to $prefix/bin/gh."
}

export PATH="$prefix/bin:$PATH"

if gh_ok; then
  echo "gh $(gh_version) already satisfies >= $min_version."
else
  current="$(gh_version || true)"
  echo "gh ${current:-missing}; need >= $min_version."
  if [[ -z "${GH_INSTALL_PREFIX:-}" ]] && can_sudo; then
    install_with_package_manager || echo "Package-manager install unavailable or failed." >&2
  else
    echo "Skipping package manager (no sudo or GH_INSTALL_PREFIX set)."
  fi
  hash -r
  if ! gh_ok; then
    echo "gh still older than $min_version; falling back to the release tarball."
    install_from_tarball
    hash -r
  fi
  gh_ok || { echo "gh is still older than $min_version; install it manually: https://cli.github.com" >&2; exit 1; }
  echo "gh $(gh_version) installed at $(command -v gh)."
fi

# ~/.local/bin must precede /usr/bin or an older distro gh keeps shadowing this one.
resolved="$(command -v gh)"
if ! gh_ok "$resolved"; then
  echo "Warning: $resolved is older than $min_version; put $prefix/bin first on PATH." >&2
fi

if ((${#extensions[@]} == 0)); then
  exit 0
fi
if ! gh auth status >/dev/null 2>&1; then
  echo "Skipping gh extensions: gh is not authenticated (run 'gh auth login', then chezmoi apply)." >&2
  exit 0
fi
installed="$(gh extension list 2>/dev/null || true)"
for ext in "${extensions[@]}"; do
  short="${ext##*/}"
  if grep -qF "$ext" <<<"$installed"; then
    gh extension upgrade "$short" || echo "Could not upgrade $short (offline?); continuing." >&2
  else
    gh extension install "$ext" || echo "Could not install $ext (offline?); continuing." >&2
  fi
done
