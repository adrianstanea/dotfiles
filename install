#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${HOME:-}" || ! -d "$HOME" || ! -w "$HOME" ]]; then
    echo "A writable HOME directory is required to bootstrap chezmoi." >&2
    exit 1
fi

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ ! -f "$repo_root/.chezmoiroot" || ! -d "$repo_root/home" ]]; then
    echo "Expected a chezmoi source root at $repo_root with .chezmoiroot and home/." >&2
    exit 1
fi

if ! command -v git >/dev/null 2>&1 || ! git -C "$repo_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Git and a cloned dotfiles repository are required." >&2
    exit 1
fi

chezmoi_bin="$(command -v chezmoi || true)"
if [[ -z "$chezmoi_bin" && -x "$HOME/.local/bin/chezmoi" ]]; then
    chezmoi_bin="$HOME/.local/bin/chezmoi"
fi

if [[ -z "$chezmoi_bin" ]]; then
    install_dir="$HOME/.local/bin"
    download_dir="$(mktemp -d)"
    trap 'rm -rf "$download_dir"' EXIT
    mkdir -p "$install_dir"

    if command -v curl >/dev/null 2>&1; then
        curl --fail --silent --show-error --location https://get.chezmoi.io \
            --output "$download_dir/chezmoi-install.sh"
    elif command -v wget >/dev/null 2>&1; then
        wget --quiet https://get.chezmoi.io \
            --output-document="$download_dir/chezmoi-install.sh"
    else
        echo "Install curl or wget to download chezmoi." >&2
        exit 1
    fi

    if ! sh "$download_dir/chezmoi-install.sh" -b "$install_dir"; then
        echo "Failed to install chezmoi into $install_dir." >&2
        exit 1
    fi
    chezmoi_bin="$install_dir/chezmoi"
fi

if [[ ! -x "$chezmoi_bin" ]]; then
    echo "chezmoi was not found or is not executable: $chezmoi_bin" >&2
    exit 1
fi

exec "$chezmoi_bin" \
    --source "$repo_root" \
    --destination "$HOME" \
    --no-tty \
    init --apply --promptDefaults